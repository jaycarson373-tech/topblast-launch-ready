{
  "name": "topblast-launchpad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "overrides": {
      "rpc-websockets": "9.3.2"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:rewards": "tsx scripts/reward-worker.ts",
    "railway:start": "node scripts/railway-start.mjs",
    "verify:production": "node scripts/verify-production.mjs"
