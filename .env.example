# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional footer destinations. Set token-specific URLs after the token exists.
NEXT_PUBLIC_DEXSCREENER_URL=
NEXT_PUBLIC_STONK_URL=https://www.stonkfun.xyz
# Set the real project profile; an empty value displays "X · link pending".
NEXT_PUBLIC_X_URL=
LAUNCHES_ENABLED=false
# Explicitly open /launch/test to everyone. Real mainnet costs, hidden listings.
# Does not enable ordinary public launches, admin access, funding or payouts.
PUBLIC_TEST_LAUNCHES_ENABLED=false
# Controlled creator addresses, comma-separated. Never private keys.
CONTROLLED_LAUNCH_WALLETS=
# Tests remain classified as tests, but may be publicly listed from creation.
CONTROLLED_TEST_LISTINGS_PUBLIC=false
# Set only after our real token is verified as a non-test launch through TopBlast.
FEATURED_TOKEN_MINT=

# Database. The service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# StonkFun public API. Override only for testing.
STONKFUN_API_URL=https://www.stonkfun.xyz/api/public/v1
STONK_QUOTE_MINT=6GmAFSYs4gk3FDao5FzzySQpPZaWsa4rUJHacpMpUNgx
NEXT_PUBLIC_STONK_QUOTE_MINT=6GmAFSYs4gk3FDao5FzzySQpPZaWsa4rUJHacpMpUNgx

# Indexing
HELIUS_API_KEY=
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_SECRET=
SOLANA_RPC_URL=

# Reward operations. Keep true until dry-run proofs are reviewed.
DRY_RUN=true
# manual_wallet requires an operator wallet approval. server_signer enables the
# Railway-only TopBlast signer after the reward engine is explicitly unpaused.
PAYOUT_MODE=manual_wallet
REWARD_EPOCH_SECONDS=3600
REWARD_WORKER_POLL_SECONDS=30
INDEX_BLOCK_BATCH_SIZE=100
MAX_PRICE_AGE_SECONDS=180
MAX_PRICE_GAP_SECONDS=180
PAYOUT_BATCH_SIZE=4
TOPBLAST_MIN_REWARD_PERCENT=50
TOPBLAST_TREASURY_ADDRESS=
PROTOCOL_TREASURY_ADDRESS=
ADMIN_API_TOKEN=
# Railway worker only. Never set either value in Vercel, Supabase or NEXT_PUBLIC_*.
TREASURY_PRIVATE_KEY=
# Hard ceiling for one automatic payout batch, in exact reward-asset atoms.
TOPBLAST_MAX_PAYOUT_ATOMS=

# Keep PAYOUT_MODE=manual_wallet unless the isolated Railway signer is configured.
PUMPFUN_ENABLED=false
